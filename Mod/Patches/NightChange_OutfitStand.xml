<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!--
    Le comp d'assignation et son grand livre sont poses sur le def vanilla du portant, et non sur un
    batiment a nous : les portants deja construits dans une partie en cours gagnent le gizmo au
    chargement, et le mod n'ajoute ni art ni cout de recherche.

    Le noeud <comps> est d'abord *assure*, puis rempli. Deux raisons, dans cet ordre :

    1. Le noeud vit sur l'abstrait OutfitStandBase, pas sur le def concret. Les PatchOperation
       s'appliquent avant la resolution de l'heritage : un xpath vers .../comps sur le def concret ne
       trouverait rien. On lui en cree un, et l'heritage concatene ensuite les deux listes.
    2. D'autres mods ajoutent des comps a ce meme def : Shift Change et Outfit Stands Plus le font.
       Un def laisse avec deux noeuds <comps> se resout au dernier arrive, avec une erreur rouge
       « defines the same field twice », et le noeud du premier mod disparait.
  -->

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Building_OutfitStand"]/comps</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="Building_OutfitStand"]</xpath>
      <value>
        <comps />
      </value>
    </nomatch>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="Building_OutfitStand"]/comps</xpath>
    <value>
      <li Class="CompProperties_AssignableToPawn">
        <compClass>NightChange.CompNightStand</compClass>
        <maxAssignedPawnsCount>1</maxAssignedPawnsCount>
        <drawAssignmentOverlay>false</drawAssignmentOverlay>
      </li>
    </value>
  </Operation>

  <!-- Le portant pour enfants de Biotech, dont la classe derive de Building_OutfitStand. -->
  <Operation Class="PatchOperationConditional" MayRequire="Ludeon.RimWorld.Biotech">
    <xpath>Defs/ThingDef[defName="Building_KidOutfitStand"]/comps</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="Building_KidOutfitStand"]</xpath>
      <value>
        <comps />
      </value>
    </nomatch>
  </Operation>

  <Operation Class="PatchOperationAdd" MayRequire="Ludeon.RimWorld.Biotech">
    <xpath>Defs/ThingDef[defName="Building_KidOutfitStand"]/comps</xpath>
    <value>
      <li Class="CompProperties_AssignableToPawn">
        <compClass>NightChange.CompNightStand</compClass>
        <maxAssignedPawnsCount>1</maxAssignedPawnsCount>
        <drawAssignmentOverlay>false</drawAssignmentOverlay>
      </li>
    </value>
  </Operation>

</Patch>
