<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!--
    The ownership comp and its ledger are patched onto the vanilla stand def rather than shipped as
    a building of our own: stands already built in an existing save gain the gizmo on load, and the
    mod adds no art and no research cost.

    The <comps> node is first *ensured*, then filled. Two reasons, in this order:

    1. The node lives on the abstract OutfitStandBase, not on the concrete def. PatchOperations run
       before inheritance is resolved, so an xpath to .../comps on the concrete def would find
       nothing. We create one, and inheritance then concatenates the two lists.
    2. Other mods add comps to this same def: Shift Change and Outfit Stands Plus both do. A def
       left with two <comps> nodes is resolved last-wins with a red "defines the same field twice"
       error, and the first mod's node disappears.
  -->

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Building_OutfitStand"]/comps</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="Building_OutfitStand"]</xpath>
      <value>
        <comps />
      </value>
    </nomatch>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="Building_OutfitStand"]/comps</xpath>
    <value>
      <li Class="CompProperties_AssignableToPawn">
        <compClass>NightChange.CompNightStand</compClass>
        <maxAssignedPawnsCount>1</maxAssignedPawnsCount>
        <drawAssignmentOverlay>false</drawAssignmentOverlay>
      </li>
    </value>
  </Operation>

  <!-- Biotech's kid outfit stand, whose class derives from Building_OutfitStand. -->
  <Operation Class="PatchOperationConditional" MayRequire="Ludeon.RimWorld.Biotech">
    <xpath>Defs/ThingDef[defName="Building_KidOutfitStand"]/comps</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="Building_KidOutfitStand"]</xpath>
      <value>
        <comps />
      </value>
    </nomatch>
  </Operation>

  <Operation Class="PatchOperationAdd" MayRequire="Ludeon.RimWorld.Biotech">
    <xpath>Defs/ThingDef[defName="Building_KidOutfitStand"]/comps</xpath>
    <value>
      <li Class="CompProperties_AssignableToPawn">
        <compClass>NightChange.CompNightStand</compClass>
        <maxAssignedPawnsCount>1</maxAssignedPawnsCount>
        <drawAssignmentOverlay>false</drawAssignmentOverlay>
      </li>
    </value>
  </Operation>

</Patch>
